<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0"
            prefWidth="420.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.nakupny_zoznm.HelloController">

    <children>

        <ListView fx:id="list"
                  layoutX="30.0"
                  layoutY="30.0"
                  prefHeight="200.0"
                  prefWidth="360.0" />

        <TextField fx:id="name"
                   layoutX="30.0"
                   layoutY="250.0"
                   prefWidth="220.0"
                   promptText="Názov položky" />

        <TextField fx:id="count"
                   layoutX="270.0"
                   layoutY="250.0"
                   prefWidth="120.0"
                   promptText="Počet kusov" />

        <Button layoutX="30.0"
                layoutY="300.0"
                mnemonicParsing="false"
                onAction="#add"
                text="Pridať" />

        <Button layoutX="120.0"
                layoutY="300.0"
                mnemonicParsing="false"
                onAction="#update"
                text="Upraviť" />

        <Button layoutX="220.0"
                layoutY="300.0"
                mnemonicParsing="false"
                onAction="#remove"
                text="Odstrániť" />

        <Label fx:id="totalLabel"
               layoutX="30.0"
               layoutY="350.0"
               text="Počet položiek: 0" />

    </children>

</AnchorPane>