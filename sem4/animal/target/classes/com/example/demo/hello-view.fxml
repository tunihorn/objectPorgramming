<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.HelloController">

    <top>
        <HBox spacing="8" style="-fx-padding: 10;">

            <Button text="Pridaj Herbivore"
                    onAction="#addHerbivore"/>

            <Button text="Pridaj Carnivore"
                    onAction="#addCarnivore"/>

            <Button text="Zmeň smer Carnivore"
                    onAction="#changeCarnivoreDirection"/>

            <Button fx:id="stopButton"
                    text="Zastav všetky zvieratá"
                    onAction="#stopOrStartAnimals"/>

        </HBox>
    </top>

    <center>
        <Pane fx:id="rootPane"
              prefWidth="780"
              prefHeight="500"
              style="-fx-background-color: white; -fx-border-color: black;"/>
    </center>

</BorderPane>
