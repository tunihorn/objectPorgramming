<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.HelloController">

    <top>
        <HBox spacing="8" style="-fx-padding: 10;">

            <Button text="Pridaj Oblak"
                    onAction="#addOblak"/>

            <Button text="Pridaj Raindrop"
                    onAction="#addRaindrop"/>

            <Button text="Pridaj Snowflake"
                    onAction="#addSnowflake"/>

            <Button fx:id="rainButton"
                    text="Zastav dážď"
                    onAction="#stopOrStartRain"/>

            <Button text="Oblaky na modro"
                    onAction="#changeCloudsToBlue"/>

            <Button text="Všetko o 20 px doľava"
                    onAction="#moveAllLeft"/>

        </HBox>
    </top>

    <center>
        <Pane fx:id="rootPane"
              prefWidth="800"
              prefHeight="520"
              style="-fx-background-color: #f3f8ff; -fx-border-color: black;"/>
    </center>

</BorderPane>
