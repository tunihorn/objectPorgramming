<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.objectporgramming.HelloController"
      spacing="10"
      prefWidth="350"
      prefHeight="320">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Zadajte vzdialenosť:"/>

    <TextField fx:id="inputField"
               promptText="Napr. 1500"/>

    <Label text="Vstupná jednotka:"/>

    <ComboBox fx:id="unitBox"
              prefWidth="310"/>

    <Button text="Previesť"
            onAction="#convertDistance"/>

    <Label fx:id="resultLabel"
           text="Výsledky sa zobrazia tu."
           wrapText="true"/>

</VBox>